<button class="nav-item" onclick="switchTab('viewTab', this)"><i class="fas fa-users"></i>Students</button>
<button class="nav-item" onclick="switchTab('sectionTab', this)"><i class="fas fa-layer-group"></i>Sections</button>
</div>

<!-- ================= FIREBASE & BACKEND LOGIC ================= -->
<script src="https://www.gstatic.com/firebasejs/10.9.0/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.9.0/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.9.0/firebase-firestore-compat.js"></script>

<script>
// 🚀 🚀 🚀 IMPORTANT: Insert your actual Google Apps Script Web App URL below 🚀 🚀 🚀
const SCRIPT_URL = "YOUR_APPS_SCRIPT_WEB_APP_URL_HERE";

const firebaseConfig = {
    apiKey: "AIzaSyBhzidG1s5CsOaiY0RsBG6GJcrE12LLEuU",
    projectId: "srms-website-management"
};
if (!firebase.apps.length) { firebase.initializeApp(firebaseConfig); }
const db = firebase.firestore();

var allData = [];
var globalSections = []; 

// 🔑 TOKEN MANAGEMENT
function getToken() {
    return sessionStorage.getItem('portal_token') || "";
}

// 🌐 BACKEND API CALLER (For Add/Delete/SMS)
async function apiCall(actionName, payloadData = {}) {
    let payload = { action: actionName, token: getToken(), ...payloadData };
    try {
        let res = await fetch(SCRIPT_URL, {
            method: 'POST', body: JSON.stringify(payload), headers: { 'Content-Type': 'text/plain;charset=utf-8' }
        });
        return await res.json();
    } catch (error) {
        console.error("API Call Failed:", error); throw error;
    }
}

function showLoader(s) { document.getElementById('loader').style.display = s ? 'flex' : 'none'; }

function switchTab(id, btn) {
    document.querySelectorAll('.container').forEach(c => c.classList.remove('active'));
    document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
    document.getElementById(id).classList.add('active');
    btn.classList.add('active');
    if(id === 'viewTab') loadStudents();
}

function toggleGroup(selId, divId) {
    var cls = document.getElementById(selId).value;
    document.getElementById(divId).style.display = (cls == "9" || cls == "10") ? "block" : "none";
}

// ==========================================
// 🚀 DIRECT FIREBASE: SECTIONS & STUDENTS
// ==========================================
async function loadSectionsData() {
    try {
        const doc = await db.collection('Admin').doc('Settings').get();
        if (doc.exists && doc.data().sections) {
            globalSections = doc.data().sections.split(',').filter(s => s.trim() !== '');
        } else {
            globalSections = ["Section A", "Section B", "Section C", "Boys", "Girls"];
        }
        updateSectionDropdowns();
        renderSectionList();
    } catch (e) { console.error("Init Error", e); }
}

function updateSectionDropdowns() {
    let opts = '<option value="">Select Section</option>';
    let filterOpts = '<option value="">All Sections</option>';
    globalSections.forEach(s => {
        opts += `<option value="${s}">${s}</option>`; filterOpts += `<option value="${s}">${s}</option>`;
    });
    document.getElementById('sSection').innerHTML = opts;
    document.getElementById('eSection').innerHTML = opts;
    document.getElementById('filterSection').innerHTML = filterOpts;
}

function renderSectionList() {
    let h = "";
    globalSections.forEach(s => {
        h += `<div class="list-item" style="padding:12px 20px; box-shadow:none; border-color:#a7f3d0;">
        <b style="color:#005f40; font-size:15px;">${s}</b>
        <button onclick="deleteSection('${s}')" style="background:#fef2f2; color:#ef4444; border:none; padding:8px 12px; border-radius:8px; cursor:pointer; transition:0.3s;"><i class="fas fa-trash"></i></button>
        </div>`;
    });
    document.getElementById('sectionListDisplay').innerHTML = h || "<p style='text-align:center; color:#94a3b8; font-weight:600;'>No custom sections added yet.</p>";
}

async function addSection() {
    let name = document.getElementById('newSecName').value.trim();
    if(!name) return alert("Please enter section name.");
    showLoader(true);
    try {
        if (!globalSections.includes(name)) globalSections.push(name);
        await db.collection('Admin').doc('Settings').set({ sections: globalSections.join(',') }, { merge: true });
        document.getElementById('newSecName').value = "";
        updateSectionDropdowns(); renderSectionList(); showLoader(false);
    } catch(e) { showLoader(false); alert("Error adding section"); }
}

async function deleteSection(name) {
    if(!confirm(`Delete section "${name}"?`)) return;
    showLoader(true);
    try {
        globalSections = globalSections.filter(s => s !== name);
        await db.collection('Admin').doc('Settings').set({ sections: globalSections.join(',') }, { merge: true });
        updateSectionDropdowns(); renderSectionList(); showLoader(false);
    } catch(e) { showLoader(false); alert("Error deleting section"); }
}

function saveStudent() {
    var cls = document.getElementById('sClass').value;
    var grp = document.getElementById('sGroup').value;
    var cardNumber = document.getElementById('sCardNumber').value;
    var f = document.getElementById('sPhoto').files[0];
    if((cls == "9" || cls == "10") && !grp) return alert("বিভাগ নির্বাচন করুন!");

    var d = { 
        name: document.getElementById('sName').value, fatherName: document.getElementById('sFatherName').value || "", fatherNid: document.getElementById('sFatherNid').value || "", motherName: document.getElementById('sMotherName').value || "", motherNid: document.getElementById('sMotherNid').value || "", bloodGroup: document.getElementById('sBloodGroup').value || "", classVal: cls, sectionVal: document.getElementById('sSection').value || "", roll: document.getElementById('sRoll').value, group: grp || "", resStatus: document.getElementById('sRes').value, category: document.getElementById('sCategory').value, machineId: document.getElementById('sMachineId').value, cardNumber: cardNumber, phone: document.getElementById('sPhone').value || "", email: document.getElementById('sEmail').value || "", cert: document.getElementById('sCert').value || "", prev: document.getElementById('sPrev').value || "", addr: document.getElementById('sAddr').value || ""
    };

    if(!d.name || !d.roll || !d.phone) return alert("নাম, রোল এবং ফোন নম্বর অবশ্যই দিন!");

    showLoader(true);
    var done = res => { 
        showLoader(false); 
        alert("সফল! স্টুডেন্ট আইডি: " + res.id + (res.machineStatus ? "\nমেশিন স্ট্যাটাস: " + res.machineStatus : "")); 
        document.getElementById('sName').value = ""; document.getElementById('sFatherName').value = ""; document.getElementById('sFatherNid').value = ""; document.getElementById('sMotherName').value = ""; document.getElementById('sMotherNid').value = ""; document.getElementById('sBloodGroup').value = ""; document.getElementById('sRoll').value = ""; document.getElementById('sPhone').value = ""; document.getElementById('sMachineId').value = ""; document.getElementById('sCardNumber').value = ""; document.getElementById('sCategory').value = "Civil"; document.getElementById('sSection').value = ""; document.getElementById('sPhoto').value = "";
    };

    if(f) {
        var r = new FileReader(); r.onload = e => { 
            d.photoData = e.target.result.split(',')[1]; d.mimeType = f.type; 
            apiCall('addNewStudentProfile', {data: d}).then(done).catch(err => {showLoader(false); alert("Error");}); 
        }; r.readAsDataURL(f);
    } else { 
        apiCall('addNewStudentProfile', {data: d}).then(done).catch(err => {showLoader(false); alert("Error");}); 
    }
}

async function loadStudents() {
    showLoader(true);
    try {
        const snapshot = await db.collection('Students').get();
        let data = [];
        snapshot.forEach(doc => {
            let f = doc.data();
            data.push({
                id: f.studentID || "", machineId: f.machineID || "", name: f.name || "", fatherName: f.fatherName || "", fatherNid: f.fatherNid || "", motherName: f.motherName || "", motherNid: f.motherNid || "", bloodGroup: f.bloodGroup || "", classVal: f.class || "", sectionVal: f.section || "", roll: f.roll || "", email: f.email || "", phone: f.phone || "", address: f.address || "", prevReg: f.prevReg || "", birthCert: f.birthCert || "", group: f.group || "", resStatus: f.resStatus || "", category: f.category || "Civil", cardNumber: f.cardNumber || "", rowId: doc.id
            });
        });
        data.sort((a,b) => (parseInt(a.roll)||9999) - (parseInt(b.roll)||9999));
        allData = data.reverse();
        renderList(allData);
        showLoader(false);
    } catch(e) {
        showLoader(false); console.error(e); alert("Failed to load students from database.");
    }
}

function renderList(data) {
    var h = ""; var total = data.length; var classCounts = {};
    data.forEach(s => {
        var cls = s.classVal || "Unknown"; classCounts[cls] = (classCounts[cls] || 0) + 1;
        var resBadge = s.resStatus === 'Residential' ? ' <i class="fas fa-home" style="color:var(--gold)" title="Residential"></i>' : '';
        var catBadge = s.category === 'Army' ? `<span class="badge-army"><i class="fas fa-shield-alt"></i> Army</span>` : `<span class="badge-civil">Civil</span>`;
        var secBadge = s.sectionVal ? `<span class="badge-section">Sec: ${s.sectionVal}</span>` : '';
        h += `<div class="list-item">
        <div style="flex:1;">
        <div style="margin-bottom:5px;"><b style="font-size:16px; color:#005f40;">${s.name}</b>${resBadge} <span style="margin-left: 10px;">${catBadge}</span></div>
        <small style="color:#64748b; font-weight:500; font-size:12px; line-height:1.6;">
        <b style="color:#334155;">ID:</b> ${s.id} | <b style="color:#334155;">Class:</b> ${s.classVal} ${secBadge} [${s.group || 'N/A'}] | <b style="color:#334155;">Roll:</b> ${s.roll} <br>
        <b style="color:#334155;">Father:</b> ${s.fatherName || 'N/A'} | <b style="color:#334155;">Phone:</b> ${s.phone || 'N/A'} | <b style="color:#334155;">BG:</b> <span style="color:#ef4444; font-weight:800;">${s.bloodGroup || 'N/A'}</span>
        </small>
        </div>
        <div class="btn-group" style="display:flex; flex-direction:column; gap:8px;">
        <button onclick="openEditByRow('${s.rowId}')" style="color:var(--edit)"><i class="fas fa-edit"></i> Edit</button>
        <button onclick="delStu('${s.rowId}')" style="color:var(--danger)"><i class="fas fa-trash"></i> Del</button>
        </div>
        </div>`;
    });
    document.getElementById('studentListDisplay').innerHTML = h || "<p style='text-align:center; color:#94a3b8; font-weight:600;'>No records found.</p>";
    document.getElementById('totalStuCount').innerText = total;
    var statsHtml = "";
    for(var c in classCounts) {
        statsHtml += `<span style="background: rgba(255,255,255,0.15); border: 1px solid rgba(255,255,255,0.3); padding: 6px 12px; border-radius: 8px; color: #fff; font-weight:600;">Class ${c}: <b style="color:var(--gold); font-size:14px; margin-left:4px;">${classCounts[c]}</b></span>`;
    }
    document.getElementById('classWiseStats').innerHTML = statsHtml;
}

function filterStudents() {
    var fCls = document.getElementById('filterClass').value; var fSec = document.getElementById('filterSection').value; var fGrp = document.getElementById('filterGroup').value; var fRes = document.getElementById('filterRes').value; var fCat = document.getElementById('filterCategory').value; var fTxt = document.getElementById('stuSearch').value.toLowerCase();
    var filtered = allData.filter(s => {
        var matchCls = fCls === "" || String(s.classVal) === fCls; var matchSec = fSec === "" || String(s.sectionVal) === fSec; var matchGrp = fGrp === "" || String(s.group) === fGrp; var matchRes = fRes === "" || String(s.resStatus) === fRes; var matchCat = fCat === "" || String(s.category) === fCat;
        var matchTxt = String(s.name).toLowerCase().includes(fTxt) || String(s.id).toLowerCase().includes(fTxt) || String(s.roll).includes(fTxt) || (s.machineId && String(s.machineId).toLowerCase().includes(fTxt)) || (s.phone && String(s.phone).includes(fTxt)); 
        return matchCls && matchSec && matchGrp && matchRes && matchCat && matchTxt;
    });
    renderList(filtered);
}

function openEditByRow(rid) {
    var s = allData.find(item => item.rowId == rid);
    if(!s) return;
    document.getElementById('eId').value = s.id; document.getElementById('eMachineId').value = s.machineId || ""; document.getElementById('eRowId').value = s.rowId; document.getElementById('eName').value = s.name; document.getElementById('eFatherName').value = s.fatherName || ""; document.getElementById('eFatherNid').value = s.fatherNid || ""; document.getElementById('eMotherName').value = s.motherName || ""; document.getElementById('eMotherNid').value = s.motherNid || ""; document.getElementById('eBloodGroup').value = s.bloodGroup || ""; document.getElementById('eClass').value = s.classVal; document.getElementById('eSection').value = s.sectionVal || ""; document.getElementById('eRoll').value = s.roll; document.getElementById('eRes').value = s.resStatus; document.getElementById('eCategory').value = s.category || "Civil"; 
    toggleGroup('eClass', 'eGroupDivEdit');
    document.getElementById('eGroup').value = s.group || ""; document.getElementById('eCardNumber').value = s.cardNumber || ""; document.getElementById('ePhone').value = s.phone || ""; document.getElementById('eEmail').value = s.email || ""; document.getElementById('eCert').value = s.birthCert || ""; document.getElementById('ePrev').value = s.prevReg || ""; document.getElementById('eAddr').value = s.address || "";
    document.getElementById('editModal').style.display = 'flex';
}

async function updateStudent() {
    var d = { rowId: document.getElementById('eRowId').value, name: document.getElementById('eName').value, fatherName: document.getElementById('eFatherName').value || "", fatherNid: document.getElementById('eFatherNid').value || "", motherName: document.getElementById('eMotherName').value || "", motherNid: document.getElementById('eMotherNid').value || "", bloodGroup: document.getElementById('eBloodGroup').value || "", machineId: document.getElementById('eMachineId').value, classVal: document.getElementById('eClass').value, sectionVal: document.getElementById('eSection').value || "", roll: document.getElementById('eRoll').value, resStatus: document.getElementById('eRes').value, category: document.getElementById('eCategory').value, group: document.getElementById('eGroup').value || "", cardNumber: document.getElementById('eCardNumber').value || "", phone: document.getElementById('ePhone').value || "", email: document.getElementById('eEmail').value || "", cert: document.getElementById('eCert').value || "", prev: document.getElementById('ePrev').value || "", addr: document.getElementById('eAddr').value || "" };
    
    showLoader(true);
    try {
        await db.collection('Students').doc(d.rowId).update({
            name: d.name, fatherName: d.fatherName, fatherNid: d.fatherNid, motherName: d.motherName, motherNid: d.motherNid, bloodGroup: d.bloodGroup, machineID: d.machineId, class: d.classVal, section: d.sectionVal, roll: d.roll, resStatus: d.resStatus, category: d.category, group: d.group, cardNumber: d.cardNumber, phone: d.phone, email: d.email, birthCert: d.cert, prevReg: d.prev, address: d.addr
        });
        if (d.phone) { apiCall('sendUpdateSMS', d); }
        showLoader(false);
        alert("Update Successful!");
        closeModal('editModal');
        loadStudents();
    } catch(e) {
        showLoader(false); console.error(e); alert("Update Failed");
    }
}

function printReport() {
    var fCls = document.getElementById('filterClass').value; var fSec = document.getElementById('filterSection').value; var fCat = document.getElementById('filterCategory').value; var fTxt = document.getElementById('stuSearch').value.toLowerCase();
    var data = allData.filter(s => {
        var matchCls = fCls === "" || String(s.classVal) === fCls; var matchSec = fSec === "" || String(s.sectionVal) === fSec; var matchCat = fCat === "" || String(s.category) === fCat; var matchTxt = s.name.toLowerCase().includes(fTxt) || String(s.id).toLowerCase().includes(fTxt);
        return matchCls && matchSec && matchCat && matchTxt;
    });

    var rows = "";
    data.forEach(s => { rows += `<tr><td>${s.id}</td><td>${s.name}</td><td>${s.fatherName || '-'}</td><td>${s.motherName || '-'}</td><td>${s.classVal}</td><td>${s.sectionVal || '-'}</td><td>${s.group || '-'}</td><td>${s.roll}</td><td><b>${s.category || 'Civil'}</b></td><td>${s.phone || ''}</td></tr>`; });
    document.getElementById('printTitle').innerText = "Student General Information List: " + (fCls ? "Class "+fCls : "All Classes") + (fSec ? " | Sec: "+fSec : "") + (fCat ? " | Cat: "+fCat : "");
    document.getElementById('printTableBody').innerHTML = rows;
    setTimeout(() => { window.print(); }, 800);
}

function delStu(row) { 
    if(confirm("Confirm delete?")) {
        showLoader(true); 
        apiCall('deleteStudent', {docId: row}).then(() => { alert("Deleted!"); loadStudents(); }).catch(e => {showLoader(false); alert("Error");}); 
    } 
}
function closeModal(id) { document.getElementById(id).style.display = 'none'; }
</script>
</body>
</html>
