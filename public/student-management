<!-- 🔒 ILLEGAL ACCESS REDIRECT (DYNAMIC DOMAIN) -->
<script>
function enforceSecurity() {
    let token = sessionStorage.getItem('portal_token');
    let isActiveSession = sessionStorage.getItem('srms_active_session');
    
    // Check if token exists OR if the token was passed via URL parameters
    const urlParams = new URLSearchParams(window.location.search);
    const tokenFromUrl = urlParams.get('token');
    
    if(tokenFromUrl) {
        sessionStorage.setItem('portal_token', tokenFromUrl);
        // Clean URL
        if (window.history.replaceState) {
            var cleanUrl = window.location.protocol + "//" + window.location.host + window.location.pathname;
            window.history.replaceState({path: cleanUrl}, '', cleanUrl);
        }
        return; 
    }

    if (!token && !isActiveSession) {
        // Build dynamic login URL
        var currentDomain = window.location.protocol + "//" + window.location.host;
        var loginUrl = currentDomain + "/login-panel/accounting-and-management-department";
        window.location.replace(loginUrl);
    }
}
// Run security check immediately
enforceSecurity();
</script>

